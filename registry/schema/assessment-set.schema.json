{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshua-small/audio-synth-symbol-registry/blob/main/registry/schema/assessment-set.schema.json",
  "title": "Open Audio and Synthesis Symbol Registry assessment set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_set_version",
    "assessed_at",
    "assessment_scope",
    "assessments"
  ],
  "properties": {
    "assessment_set_version": { "const": "0.1.0" },
    "assessed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?[+-][0-9]{2}:[0-9]{2}$"
    },
    "assessment_scope": { "type": "string", "minLength": 1 },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/joshua-small/audio-synth-symbol-registry/blob/main/registry/schema/acceptance-assessment.schema.json"
      }
    }
  }
}
