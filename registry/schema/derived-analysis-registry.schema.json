{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshua-small/audio-synth-symbol-registry/blob/main/registry/schema/derived-analysis-registry.schema.json",
  "title": "Derived analysis registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.1.0" },
    "registry_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "title", "path", "content_sha256", "kind", "produced_at", "input_evidence_ids", "input_artifact_refs", "scope", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^DA-[0-9]{3}$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(docs|evidence/reports)/.+[.]md$" },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "enum": ["corpus-analysis", "boundary-analysis", "overlap-audit", "historical-analysis", "status-synthesis"] },
          "produced_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?[+-][0-9]{2}:[0-9]{2}$" },
          "input_evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^EV-[0-9]{3,}$" }, "uniqueItems": true },
          "input_artifact_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/artifact_dependency" },
            "uniqueItems": true
          },
          "scope": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "artifact_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^DA-[0-9]{3}$" },
        "artifact_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    }
  }
}
