{
  "name": "audio-synth-symbol-registry",
  "version": "0.8.0",
  "private": true,
  "description": "Evidence-led open registry for audio and synthesis symbols.",
  "type": "module",
  "scripts": {
    "study:package": "node tooling/build-study-package.mjs",
    "study:harness": "node tooling/build-offline-study-harness.mjs",
    "study:synthetic-validate": "node tooling/validate-synthetic-study-export.mjs",
    "report:hygiene": "node tooling/check-agent-reports.mjs",
    "svg:validate": "node tooling/validate-study-svg.mjs",
    "svg:qa": "node tooling/render-svg-qa.mjs",
    "interchange": "node tooling/interchange-prototype.mjs",
    "font:private-proof": "node tooling/private-font-proof/validate-private-font-proof.mjs",
    "validate": "node tooling/validate-registry.mjs",
    "test": "npm run validate && npm run report:hygiene && node --test tests/*.test.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "ajv": "8.17.1",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "svg-path-parser": "1.1.0"
  }
}
